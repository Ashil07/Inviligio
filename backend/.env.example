# Copy to backend/.env (git-ignored). Spring Boot imports it at startup.
# Values here are for LOCAL development only.

# --- Option A: local PostgreSQL from docker-compose.yml (repo root) ---
DB_URL=jdbc:postgresql://localhost:5432/invigilo
DB_USERNAME=invigilo
DB_PASSWORD=invigilo

# --- Option B: Supabase (Project Settings -> Database -> Connection string -> JDBC, "Session pooler") ---
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&reWriteBatchedInserts=true
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=<database password>

# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-local-dev-only-0123456789abcdef

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Swagger UI and /v3/api-docs. Set to false in production (docs/DEPLOYMENT.md).
# API_DOCS_ENABLED=true

# Refresh cookie is Secure by default; browsers accept that on http://localhost too.
# REFRESH_COOKIE_SECURE=true
# REFRESH_TOKEN_TTL=P14D
# JWT_ACCESS_TOKEN_TTL=PT15M

# --- Demo data (only with SPRING_PROFILES_ACTIVE=demo) ---
# Creates college DEMO with 50 faculty and a seated exam week. Local development only.
# DEMO_ADMIN_EMAIL=examcell@demo.invigilo.test
# DEMO_ADMIN_PASSWORD=demo-only-password-change-me
